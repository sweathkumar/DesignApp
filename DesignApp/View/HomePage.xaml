<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DesignApp.View.HomePage"
             Title="HomePage">

    <Grid RowDefinitions="Auto,*" Padding="20,50,20,0">
        <!-- Top Bar -->
        <Border Grid.Row="0" HeightRequest="57" BackgroundColor="{StaticResource Secondary}" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,*,*" Padding="10">
                <Image Grid.Column="0" HorizontalOptions="Start" Source="logo.png" HeightRequest="33" WidthRequest="33"/>
                <Label Grid.Column="1" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="22" Text="Home" TextColor="{StaticResource PrimaryDarkText}" Style="{StaticResource SemiBold}"/>
                <Image Grid.Column="2" HorizontalOptions="End" Source="profileicon.png" HeightRequest="33" WidthRequest="33">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Border>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="14" Margin="0,20">
                <Border HeightRequest="200">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <CarouselView x:Name="MyCarousel" Loop="True" HeightRequest="200">
                        <CarouselView.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>caroone.png</x:String>
                                <x:String>carotwo.png</x:String>
                                <x:String>carothree.png</x:String>
                            </x:Array>
                        </CarouselView.ItemsSource>
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}" Aspect="AspectFill" />
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>
                </Border>


                <Label Text="Trending" FontSize="22" Style="{StaticResource SemiBold}"/>
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                    <Frame Grid.Column="0" Padding="0" HeightRequest="80" BackgroundColor="{StaticResource Gray300}" BorderColor="Transparent" CornerRadius="15" />
                    <Frame Grid.Column="1" Padding="0" HeightRequest="80" BackgroundColor="{StaticResource Gray100}" BorderColor="Transparent" CornerRadius="15" />
                    <Frame Grid.Column="2" Padding="0" HeightRequest="80" BackgroundColor="{StaticResource Gray400}" BorderColor="Transparent" CornerRadius="15" />
                    <Frame Grid.Column="3" Padding="0" HeightRequest="80" BackgroundColor="{StaticResource Gray300}" BorderColor="Transparent" CornerRadius="15" />
                </Grid>

                <Label Text="Collections" FontSize="22" Style="{StaticResource SemiBold}"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Frame Grid.Column="0" Padding="0" HeightRequest="160" BackgroundColor="{StaticResource Gray200}" BorderColor="Transparent" CornerRadius="15" />
                    <Frame Grid.Column="1" Padding="0" HeightRequest="160" BackgroundColor="{StaticResource Gray100}" BorderColor="Transparent" CornerRadius="15" />
                </Grid>

                <Label Text="Libraries" FontSize="22" Style="{StaticResource SemiBold}"/>
                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*" ColumnSpacing="10" RowSpacing="10">
                    <Frame Grid.Row="0" Grid.Column="0" Padding="0" HeightRequest="160" BackgroundColor="{StaticResource Gray200}" BorderColor="Transparent" CornerRadius="15" />
                    <Frame Grid.Row="0" Grid.Column="1" Padding="0" HeightRequest="160" BackgroundColor="{StaticResource Gray300}" BorderColor="Transparent" CornerRadius="15" />
                    <Frame Grid.Row="1" Grid.Column="0" Padding="0" HeightRequest="160" BackgroundColor="{StaticResource Gray400}" BorderColor="Transparent" CornerRadius="15" />
                    <Frame Grid.Row="1" Grid.Column="1" Padding="0" HeightRequest="160" BackgroundColor="{StaticResource Gray200}" BorderColor="Transparent" CornerRadius="15" />
                    <Frame Grid.Row="2" Grid.Column="0" Padding="0" HeightRequest="160" BackgroundColor="{StaticResource Gray500}" BorderColor="Transparent" CornerRadius="15" />
                    <Frame Grid.Row="2" Grid.Column="1" Padding="0" HeightRequest="160" BackgroundColor="{StaticResource Gray100}" BorderColor="Transparent" CornerRadius="15" />
                </Grid>
                <Label Text="Libraries" FontSize="22" Style="{StaticResource SemiBold}"/>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
