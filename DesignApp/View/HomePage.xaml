                            <Frame HeightRequest="300" WidthRequest="230" BackgroundColor="{StaticResource Gray400}" BorderColor="Transparent" CornerRadius="15">

                            </Frame>
                        </VerticalStackLayout>
                        <VerticalStackLayout>
                            <Label Text="New To World" FontSize="18" TextColor="{StaticResource Gray600}" Style="{StaticResource Regular}"/>
                            <Frame HeightRequest="300" WidthRequest="230" BackgroundColor="{StaticResource Gray100}" BorderColor="Transparent" CornerRadius="15">

                            </Frame>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </ScrollView>
                <StackLayout Padding="0,40">
                    <Label Text="A Design App" FontSize="40" Style="{StaticResource SemiBold}"/>
                    <Label Text="By Team Blue" FontSize="20" Style="{StaticResource SemiBold}" TextColor="{StaticResource Gray300}"/>
                    <Label Text="App Project Developed by Sweathkumar Projects." FontSize="18" Style="{StaticResource Regular}"/>
                    <Border HeightRequest="1" Margin="0,20"/>
                    <Label Text="All Rights Reserved © CopyRights 2025 | sweathkumarpersonal@gmail.com" FontSize="10" Style="{StaticResource Regular}"/>
                </StackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
