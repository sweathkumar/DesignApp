<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DesignApp.View.HomePage"
             Title="HomePage">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Fixed Header -->
        <Grid Row="0" Padding="20,50,20,10" BackgroundColor="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Text="Home" Style="{StaticResource Bold}" TextColor="Black" FontSize="30"/>
            <ImageButton Grid.Column="2" Source="settingsicon.png" HeightRequest="22" WidthRequest="22" Clicked="ImageButton_Clicked"/>
        </Grid>
        <Border Grid.Row="1" BackgroundColor="{StaticResource Gray100}"/>
        <!-- Scrollable Content -->
        <ScrollView Grid.Row="2" Padding="0,10">
            <VerticalStackLayout Spacing="20" Padding="0">

                <!-- Top Picks Section -->
                <VerticalStackLayout>
                    <Label Text="Top Picks For You" FontSize="22" Margin="20,0" Style="{StaticResource SemiBold}" />
                    <Label Text="Suggested List" FontSize="18" Margin="20,5" Style="{StaticResource Regular}" TextColor="{StaticResource Gray400}" />
                    <ScrollView Orientation="Horizontal" HeightRequest="300" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="10" Padding="20,0,0,0">
                            <!-- Repeat frames here -->
                            <Frame Padding="0" WidthRequest="200" HeightRequest="300">
                                <VerticalStackLayout>
                                    <Image Source="pica.jpg" Aspect="AspectFill" HeightRequest="240" />
                                    <StackLayout BackgroundColor="Brown" HeightRequest="60" />
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Padding="0" WidthRequest="200" HeightRequest="300">
                                <VerticalStackLayout>
                                    <Image Source="picb.jpg" Aspect="AspectFill" HeightRequest="240" />
                                    <StackLayout BackgroundColor="Brown" HeightRequest="60" />
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Padding="0" WidthRequest="200" HeightRequest="300">
                                <VerticalStackLayout>
                                    <Image Source="pic.jpg" Aspect="AspectFill" HeightRequest="240" />
                                    <StackLayout BackgroundColor="Brown" HeightRequest="60" />
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Padding="0" WidthRequest="200" HeightRequest="300">
                                <VerticalStackLayout>
                                    <Image Source="picd.jpg" Aspect="AspectFill" HeightRequest="240" />
                                    <StackLayout BackgroundColor="Brown" HeightRequest="60" />
                                </VerticalStackLayout>
                            </Frame>
                            <!-- Add more frames -->
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Recently Viewed Section -->
                <VerticalStackLayout>
                    <Label Text="Recently Viewed" FontSize="22" Margin="20,5" Style="{StaticResource SemiBold}" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="10" Padding="20,0,0,0">
                            <!-- Repeated vertical stack layouts with borders -->
                            <VerticalStackLayout>
                                <Border Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Image Source="pice.jpg" Aspect="AspectFill" HeightRequest="150" WidthRequest="150"/>
                                </Border>
                                <Label Text="English" FontSize="18" Style="{StaticResource Medium}" Margin="0,5"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout>
                                <Border Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Image Source="picf.jpg" Aspect="AspectFill" HeightRequest="150" WidthRequest="150"/>
                                </Border>
                                <Label Text="English" FontSize="18" Style="{StaticResource Medium}" Margin="0,5"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout>
                                <Border Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Image Source="picg.jpg" Aspect="AspectFill" HeightRequest="150" WidthRequest="150"/>
                                </Border>
                                <Label Text="English" FontSize="18" Style="{StaticResource Medium}" Margin="0,5"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout>
                                <Border Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Image Source="pich.jpg" Aspect="AspectFill" HeightRequest="150" WidthRequest="150"/>
                                </Border>
                                <Label Text="English" FontSize="18" Style="{StaticResource Medium}" Margin="0,5"/>
                            </VerticalStackLayout>
                            <!-- More items -->
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Recently Added Section -->
                <VerticalStackLayout>
                    <Label Text="Recently Added" FontSize="22" Margin="20,0" Style="{StaticResource SemiBold}" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="10" Padding="20,0,0,0">
                            <VerticalStackLayout>
                                <Border Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout HeightRequest="150" WidthRequest="150" BackgroundColor="{StaticResource Primary}" />
                                </Border>
                                <Label Text="New Fund" FontSize="18" Style="{StaticResource Medium}" Margin="0,5"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout>
                                <Border Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout HeightRequest="150" WidthRequest="150" BackgroundColor="{StaticResource Primary}" />
                                </Border>
                                <Label Text="New Fund" FontSize="18" Style="{StaticResource Medium}" Margin="0,5"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout>
                                <Border Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout HeightRequest="150" WidthRequest="150" BackgroundColor="{StaticResource Primary}" />
                                </Border>
                                <Label Text="New Fund" FontSize="18" Style="{StaticResource Medium}" Margin="0,5"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout>
                                <Border Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout HeightRequest="150" WidthRequest="150" BackgroundColor="{StaticResource Primary}" />
                                </Border>
                                <Label Text="New Fund" FontSize="18" Style="{StaticResource Medium}" Margin="0,5"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout>
                                <Border Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout HeightRequest="150" WidthRequest="150" BackgroundColor="{StaticResource Primary}" />
                                </Border>
                                <Label Text="New Fund" FontSize="18" Style="{StaticResource Medium}" Margin="0,5"/>
                            </VerticalStackLayout>
                            <!-- More items -->
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <Label Text="Top Grossing" FontSize="22" Margin="20,0" Style="{StaticResource SemiBold}" />
                    <Label Text="Suggested List" FontSize="18" Margin="20,5" Style="{StaticResource Regular}" TextColor="{StaticResource Gray400}" />
                    <ScrollView Orientation="Horizontal" HeightRequest="300" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="10" Padding="20,0,20,0">
                            <!-- Repeat frames here -->
                            <Frame Padding="0" WidthRequest="200" HeightRequest="300">
                                <VerticalStackLayout>
                                    <StackLayout BackgroundColor="ForestGreen" HeightRequest="240" />
                                    <StackLayout BackgroundColor="Green" HeightRequest="60" />
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Padding="0" WidthRequest="200" HeightRequest="300">
                                <VerticalStackLayout>
                                    <StackLayout BackgroundColor="ForestGreen" HeightRequest="240" />
                                    <StackLayout BackgroundColor="Green" HeightRequest="60" />
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Padding="0" WidthRequest="200" HeightRequest="300">
                                <VerticalStackLayout>
                                    <StackLayout BackgroundColor="ForestGreen" HeightRequest="240" />
                                    <StackLayout BackgroundColor="Green" HeightRequest="60" />
                                </VerticalStackLayout>
                            </Frame>
                            <Frame Padding="0" WidthRequest="200" HeightRequest="300">
                                <VerticalStackLayout>
                                    <StackLayout BackgroundColor="ForestGreen" HeightRequest="240" />
                                    <StackLayout BackgroundColor="Green" HeightRequest="60" />
                                </VerticalStackLayout>
                            </Frame>
                            <!-- Add more frames -->
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="3" BackgroundColor="{StaticResource Gray900}" StrokeThickness="1"/>
    </Grid>
</ContentPage>
