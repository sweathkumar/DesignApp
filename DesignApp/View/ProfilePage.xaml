<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DesignApp.Controls"
             x:Class="DesignApp.View.ProfilePage"
             Title="ProfilePage">
    <Grid RowDefinitions="Auto,*">
        <Grid RowDefinitions='*,Auto' Grid.Row="0" Padding="20,10" BackgroundColor="{StaticResource Secondary}">
            <StackLayout Grid.Row="0" HeightRequest="50"></StackLayout>
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Grid.Row="1" ColumnSpacing="10">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1"/>
                </Grid.GestureRecognizers>
                <Image Grid.Column="0" Source="back" HeightRequest="30" WidthRequest="30"/>
                <Label Grid.Column="1" Text="Profie Page" VerticalTextAlignment="Center" HorizontalTextAlignment="Center" FontSize="20" Style="{StaticResource Medium}" TextColor="Black"/>
                <ImageButton Grid.Column="3" Source="settings" HeightRequest="30" WidthRequest="30"/>
            </Grid>
        </Grid>
        <ScrollView Grid.Row="1">
            <StackLayout Spacing="10">
                <StackLayout BackgroundColor="{StaticResource SecondaryDarkText}" HeightRequest="200">
                    <Frame Margin="100,100" CornerRadius="100" BorderColor="{StaticResource Primary}" Padding="0" HeightRequest="150" WidthRequest="150">
                        <Image Source="logo.png" Margin="20"/>
                    </Frame>
                </StackLayout>
                <StackLayout Padding="20,60" Spacing="10">
                    <Label Text="Name" VerticalTextAlignment="Center" HorizontalTextAlignment="Start" FontSize="26" Style="{StaticResource Medium}"/>
                    <Frame Style="{StaticResource EntryFrameStyle}">
                        <controls:RoundedEntry Placeholder="Adam Jhon" Style="{StaticResource StyledEntry}"/>
                    </Frame>
                    <Label Text="Phone Number" VerticalTextAlignment="Center" HorizontalTextAlignment="Start" FontSize="26" Style="{StaticResource Medium}"/>
                    <Frame Style="{StaticResource EntryFrameStyle}">
                        <controls:RoundedEntry Keyboard="Telephone" MaxLength="10" Placeholder="0123456789" Style="{StaticResource StyledEntry}"/>
                    </Frame>
                    <Label Text="Email" VerticalTextAlignment="Center" HorizontalTextAlignment="Start" FontSize="26" Style="{StaticResource Medium}"/>
                    <Frame Style="{StaticResource EntryFrameStyle}">
                        <controls:RoundedEntry Keyboard="Email" Placeholder="example@gmail.com" Style="{StaticResource StyledEntry}"/>
                    </Frame>
                    <Label Text="Gender" VerticalTextAlignment="Center" HorizontalTextAlignment="Start" FontSize="26" Style="{StaticResource Medium}"/>
                    <HorizontalStackLayout Spacing="20">
                        <RadioButton Content="Male" GroupName="Gender" Value="Male"></RadioButton>
                        <RadioButton Content="Female" GroupName="Gender" Value="Female"/>
                    </HorizontalStackLayout>
                    <Label Text="Age" VerticalTextAlignment="Center" HorizontalTextAlignment="Start" FontSize="26" Style="{StaticResource Medium}"/>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Frame Style="{StaticResource EntryFrameStyle}">
                            <controls:RoundedEntry x:Name="AgeEntry" Placeholder="Enter Age" IsReadOnly="True" InputTransparent="True" Keyboard="Numeric" MaxLength="2" Style="{StaticResource StyledEntry}"/>
                        </Frame>
                        <Stepper Grid.Column="2" WidthRequest="100" Minimum="18" ValueChanged="Stepper_ValueChanged" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Achivement" VerticalTextAlignment="Center" HorizontalTextAlignment="Start" FontSize="26" Style="{StaticResource Medium}"/>
                        <Label Grid.Column="2" Text="2 / 10" VerticalTextAlignment="Center" HorizontalTextAlignment="Start" FontSize="26" Style="{StaticResource Medium}"/>
                        <Image Grid.Column="3" Source="star" HeightRequest="30" WidthRequest="30"/>
                    </Grid>
                    <ProgressBar Progress="0.2" HeightRequest="20" BackgroundColor="Transparent"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="Reset" FontSize="22" Margin="0,20" BackgroundColor="{StaticResource Gray100}" BorderColor="White" TextColor="Black" CornerRadius="30"></Button>
                        <Button Grid.Column="1" Text="Save" FontSize="22" BackgroundColor="{StaticResource Primary}" CornerRadius="30" Margin="0,20" TextColor="{StaticResource White}"></Button>
                    </Grid>
                    <StackLayout Padding="0,40">
                        <Label Text="A Design App" FontSize="40" Style="{StaticResource SemiBold}"/>
                        <Label Text="By Team Blue" FontSize="20" Style="{StaticResource SemiBold}" TextColor="{StaticResource Gray300}"/>
                        <Label Text="App Project Developed by Sweathkumar Projects." FontSize="18" Style="{StaticResource Regular}"/>
                        <Border HeightRequest="1" Margin="0,20"/>
                        <Label Text="All Rights Reserved © CopyRights 2025" HorizontalTextAlignment="Center" FontSize="10" Style="{StaticResource Regular}"/>
                        <Label Text="sweathkumarpersonal@gmail.com" HorizontalTextAlignment="Center" FontSize="10" Style="{StaticResource Regular}"/>
                    </StackLayout>
                </StackLayout>
            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>