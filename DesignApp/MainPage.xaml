<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DesignApp.MainPage">

    <ScrollView x:Name="scrollView" Padding="20,50">

        <VerticalStackLayout Spacing="20">

            <Label Text="Sign In" FontSize="33" />

            <Entry Placeholder="First Name" Keyboard="Text" />

            <Entry Placeholder="Last Name" Keyboard="Text" />

            <Entry Placeholder="Phone Number" Keyboard="Telephone" />

            <Entry Placeholder="Phone Number 2" Keyboard="Telephone" />

            <Entry Placeholder="Extra Field 1" Keyboard="Text" />

            <Entry Placeholder="Extra Field 2" Keyboard="Text" />

            <Entry Placeholder="Extra Field 3" Keyboard="Text" />

            <Entry Placeholder="Extra Field 4" Keyboard="Text" />

            <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
                <Button Text="Back" WidthRequest="100" />
                <Button Text="Next" WidthRequest="100" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
